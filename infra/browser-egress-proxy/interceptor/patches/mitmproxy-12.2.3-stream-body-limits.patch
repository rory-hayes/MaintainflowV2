+    def check_actual_body_size(
+        self, request: bool, forwarded: bool, chunk_size: int
+    ) -> layer.CommandGenerator[bool]:
+        """Bound cumulative received and forwarded bytes for every body path."""
+        if chunk_size < 0:  # pragma: no cover - all callers pass len(bytes)
+            raise ValueError("body chunk size cannot be negative")
+
+        side = "request" if request else "response"
+        direction = "forwarded" if forwarded else "received"
+        field = f"{side}_body_{direction}_bytes"
+        total = getattr(self, field) + chunk_size
+        setattr(self, field, total)
+        limit = (
+            MAINTAINFLOW_MAX_REQUEST_BODY_BYTES
+            if request
+            else MAINTAINFLOW_MAX_RESPONSE_BODY_BYTES
+        )
+        if total <= limit:
+            return False
+
+        err_msg = (
+            f"{'Request' if request else 'Response'} body exceeds "
+            "Maintain Flow's cumulative actual-byte limit."
+        )
+        err_code = (
+            ErrorCode.REQUEST_TOO_LARGE if request else ErrorCode.RESPONSE_TOO_LARGE
+        )
+        self.flow.error = flow.Error(err_msg)
+        yield HttpErrorHook(self.flow)
+        yield SendHttp(
+            ResponseProtocolError(self.stream_id, err_msg, err_code),
+            self.context.client,
+        )
+        self.client_state = self.state_errored
+        if self.context.server.connected:
+            yield SendHttp(
+                RequestProtocolError(self.stream_id, err_msg, err_code),
+                self.context.server,
+            )
+        self.server_state = self.state_errored
+        self.flow.live = False
+        return True
+
