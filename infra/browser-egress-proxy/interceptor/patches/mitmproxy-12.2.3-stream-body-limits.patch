+@pytest.mark.parametrize("where", ["request", "response"])
+def test_maintainflow_stream_transform_cannot_expand_past_limit(
+    tctx, monkeypatch, where
+):
+    monkeypatch.setattr(http, "MAINTAINFLOW_MAX_REQUEST_BODY_BYTES", 3)
+    monkeypatch.setattr(http, "MAINTAINFLOW_MAX_RESPONSE_BODY_BYTES", 3)
+    server = Placeholder(Server)
+    flow = Placeholder(HTTPFlow)
+    playbook = Playbook(http.HttpLayer(tctx, HTTPMode.regular))
+
+    def expand_stream(active_flow: HTTPFlow):
+        if active_flow.response is None:
+            active_flow.request.stream = lambda chunk: chunk * 2
+        else:
+            active_flow.response.stream = lambda chunk: chunk * 2
+
+    if where == "request":
+        assert (
+            playbook
+            >> DataReceived(
+                tctx.client,
+                b"POST http://example.com/ HTTP/1.1\r\n"
+                b"Host: example.com\r\nTransfer-Encoding: chunked\r\n\r\n"
+                b"2\r\nab\r\n",
+            )
+            << http.HttpRequestHeadersHook(flow)
+            >> reply(side_effect=expand_stream)
+            << OpenConnection(server)
+            >> reply(None)
+            << SendData(
+                server,
+                b"POST / HTTP/1.1\r\nHost: example.com\r\n"
+                b"Transfer-Encoding: chunked\r\n\r\n",
+            )
+            << http.HttpErrorHook(flow)
+            >> reply()
+            << SendData(tctx.client, BytesMatching(b"413 Payload Too Large"))
+            << CloseConnection(tctx.client)
+            << CloseConnection(server)
+        )
+    else:
+        assert (
+            playbook
+            >> DataReceived(
+                tctx.client,
+                b"GET http://example.com/ HTTP/1.1\r\nHost: example.com\r\n\r\n",
+            )
+            << http.HttpRequestHeadersHook(flow)
+            >> reply()
+            << http.HttpRequestHook(flow)
+            >> reply()
+            << OpenConnection(server)
+            >> reply(None)
+            << SendData(server, b"GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
+            >> DataReceived(
+                server,
+                b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nab\r\n",
+            )
+            << http.HttpResponseHeadersHook(flow)
+            >> reply(side_effect=expand_stream)
+            << SendData(
+                tctx.client,
+                b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n",
+            )
+            << http.HttpErrorHook(flow)
+            >> reply()
+            << CloseConnection(tctx.client)
+            << CloseConnection(server)
+        )
+
