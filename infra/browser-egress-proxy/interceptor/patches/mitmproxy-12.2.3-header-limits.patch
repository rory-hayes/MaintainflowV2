+def sized_request_head(size: int) -> bytes:
+    prefix = b"POST / HTTP/1.1\r\nContent-Length: 3\r\nX-Pad: "
+    suffix = b"\r\n\r\n"
+    assert size >= len(prefix) + len(suffix)
+    head = prefix + b"a" * (size - len(prefix) - len(suffix)) + suffix
+    assert len(head) == size
+    return head
+
+
+def sized_response_head(size: int) -> bytes:
+    prefix = b"HTTP/1.1 200 OK\r\nContent-Length: 3\r\nX-Pad: "
+    suffix = b"\r\n\r\n"
+    assert size >= len(prefix) + len(suffix)
+    head = prefix + b"a" * (size - len(prefix) - len(suffix)) + suffix
+    assert len(head) == size
+    return head
