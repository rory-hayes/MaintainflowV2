 example_response_trailers = ((b"resp-trailer-a", b"a"), (b"resp-trailer-b", b"b"))
 
+HEADER_LIST_LIMIT = 64 * 1024
+
+
+def sized_h2_headers(client_side: bool, size: int) -> list[tuple[bytes, bytes]]:
+    base = list(example_response_headers if client_side else example_request_headers)
+    base_size = sum(hpack.table.table_entry_size(*field) for field in base)
+    padding_name = b"x-pad"
+    padding_overhead = hpack.table.table_entry_size(padding_name, b"")
+    padding_size = size - base_size - padding_overhead
+    assert padding_size >= 0
+    headers = [*base, (padding_name, b"a" * padding_size)]
+    assert sum(hpack.table.table_entry_size(*field) for field in headers) == size
+    return headers
+
+
+def receive_sized_h2_headers(client_side: bool, size: int):
+    receiver = BufferedH2Connection(
+        h2.config.H2Configuration(client_side=client_side, header_encoding=False)
+    )
+    peer = h2.connection.H2Connection(
+        h2.config.H2Configuration(client_side=not client_side, header_encoding=False)
+    )
+    receiver.initiate_connection()
+    peer.initiate_connection()
+    receiver.receive_data(peer.data_to_send())
+    peer.receive_data(receiver.data_to_send())
+    receiver.receive_data(peer.data_to_send())
+
+    if client_side:
+        receiver.send_headers(1, example_request_headers, end_stream=True)
+        peer.receive_data(receiver.data_to_send())
+
+    peer.send_headers(1, sized_h2_headers(client_side, size), end_stream=True)
+    return receiver.receive_data(peer.data_to_send())
+
+
+@pytest.mark.parametrize("client_side", [False, True])
+def test_header_list_limit_is_explicit(client_side, monkeypatch):
+    monkeypatch.setattr(
+        h2.connection.H2Connection, "DEFAULT_MAX_HEADER_LIST_SIZE", 1024 * 1024
+    )
+    conn = BufferedH2Connection(h2.config.H2Configuration(client_side=client_side))
+    assert conn.local_settings.max_header_list_size == HEADER_LIST_LIMIT
+    assert conn.decoder.max_header_list_size == HEADER_LIST_LIMIT
+
+
+@pytest.mark.parametrize("client_side", [False, True])
+def test_header_list_limit_exact_boundary(client_side):
+    events = receive_sized_h2_headers(client_side, HEADER_LIST_LIMIT)
+    event_type = (
+        h2.events.ResponseReceived if client_side else h2.events.RequestReceived
+    )
+    assert any(isinstance(event, event_type) for event in events)
+
+
+@pytest.mark.parametrize("client_side", [False, True])
+def test_header_list_limit_rejects_decompressed_oversize(client_side):
+    with pytest.raises(h2.exceptions.DenialOfServiceError):
+        receive_sized_h2_headers(client_side, HEADER_LIST_LIMIT + 1)
+
 
