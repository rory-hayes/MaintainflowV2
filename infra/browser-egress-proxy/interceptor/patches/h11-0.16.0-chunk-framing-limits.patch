diff --git a/h11/tests/test_io.py b/h11/tests/test_io.py
index 407e044..480f092 100644
--- a/h11/tests/test_io.py
+++ b/h11/tests/test_io.py
@@ -473,6 +473,64 @@ def test_ChunkedReader() -> None:
     t_body_reader(ChunkedReader, b"3\r\nxxx_\n1a\r\n", [LocalProtocolError])
 
 
+def test_chunk_header_limit_exact_boundary_and_trailing_body() -> None:
+    from .._readers import MAINTAINFLOW_MAX_CHUNK_HEADER_BYTES
+
+    line = (
+        b"1;"
+        + b"a" * (MAINTAINFLOW_MAX_CHUNK_HEADER_BYTES - len(b"1;\r\n"))
+        + b"\r\n"
+    )
+    buf = makebuf(line + b"x\r\n0\r\n\r\ntrailing")
+    assert _run_reader(ChunkedReader(), buf, False) == [
+        Data(data=b"x"),
+        EndOfMessage(),
+    ]
+    assert bytes(buf) == b"trailing"
+
+
+def test_chunk_header_limit_rejects_slow_fragment_before_parse() -> None:
+    from .._readers import MAINTAINFLOW_MAX_CHUNK_HEADER_BYTES
+
+    reader = ChunkedReader()
+    buf = makebuf(b"1;" + b"a" * (MAINTAINFLOW_MAX_CHUNK_HEADER_BYTES - 2))
+    assert reader(buf) is None
+    buf += b"a"
+    with pytest.raises(LocalProtocolError, match="chunk header"):
+        reader(buf)
+
+
+def test_chunk_trailer_limit_exact_boundary_and_trailing_bytes() -> None:
+    from .._readers import MAINTAINFLOW_MAX_CHUNK_TRAILER_BYTES
+
+    reader = ChunkedReader()
+    buf = makebuf(b"0\r\n")
+    assert reader(buf) is None
+    trailer = (
+        b"x:"
+        + b"a" * (MAINTAINFLOW_MAX_CHUNK_TRAILER_BYTES - len(b"x:\r\n\r\n"))
+        + b"\r\n\r\n"
+    )
+    buf += trailer + b"trailing"
+    event = reader(buf)
+    assert isinstance(event, EndOfMessage)
+    assert event.headers == [(b"x", b"a" * (len(trailer) - len(b"x:\r\n\r\n")))]
+    assert bytes(buf) == b"trailing"
+
+
+def test_chunk_trailer_limit_rejects_slow_fragment_before_parse() -> None:
+    from .._readers import MAINTAINFLOW_MAX_CHUNK_TRAILER_BYTES
+
+    reader = ChunkedReader()
+    buf = makebuf(b"0\r\n")
+    assert reader(buf) is None
+    buf += b"x:" + b"a" * (MAINTAINFLOW_MAX_CHUNK_TRAILER_BYTES - 2)
+    assert reader(buf) is None
+    buf += b"a"
+    with pytest.raises(LocalProtocolError, match="trailer"):
+        reader(buf)
+
+
