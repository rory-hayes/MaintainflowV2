# syntax=docker/dockerfile:1.7

ARG GO_IMAGE=golang:1.26.5-trixie@sha256:4ee9ffa999b4583ce281939cdff828763083610292f252279a0cee77473bd9a7
ARG PYTHON_IMAGE=python:3.13.11-slim-trixie@sha256:2b9c9803c6a287cafa0a8c917211dddd23dcd2016f049690ee5219f5d3f1636e

FROM ${GO_IMAGE} AS builder
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
COPY infra/browser-egress-proxy/go.mod infra/browser-egress-proxy/go.sum ./
RUN go mod download && go mod verify
COPY infra/browser-egress-proxy/cmd ./cmd
COPY infra/browser-egress-proxy/internal ./internal
RUN test -n "${TARGETARCH}" \
    && CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
      go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/policy-dialer ./cmd/policy-dialer

FROM ${PYTHON_IMAGE} AS privilege-tool-source
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends util-linux \
    && mkdir -p /out/bin /out/lib \
    && cp /usr/bin/setpriv /out/bin/setpriv \
    && setpriv_library="$(ldd /usr/bin/setpriv | awk '$1 == "libcap-ng.so.0" { print $3 }')" \
    && test -n "${setpriv_library}" \
    && cp -L "${setpriv_library}" /out/lib/libcap-ng.so.0 \
    && /out/bin/setpriv --version \
    && rm -rf /var/lib/apt/lists/*

FROM ${PYTHON_IMAGE} AS runtime
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates nftables \
    && groupadd --gid 10001 maintainflow \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin maintainflow \
    && rm -f /usr/local/lib/python3.13/lib-dynload/_sqlite3*.so \
    && apt-get purge --allow-remove-essential --yes \
      bsdutils \
      gzip \
      libblkid1 \
      liblastlog2-2 \
      libmount1 \
      libncursesw6 \
      libsmartcols1 \
      libsqlite3-0 \
      libuuid1 \
      login \
      mount \
      ncurses-base \
      ncurses-bin \
      perl-base \
      util-linux \
    && python -c 'import pathlib, shutil; path = pathlib.Path("/var/lib/apt/lists"); shutil.rmtree(path); path.mkdir(parents=True)'
COPY --from=privilege-tool-source /out/bin/setpriv /usr/local/bin/setpriv
COPY --from=privilege-tool-source /out/lib/libcap-ng.so.0 /usr/local/lib/libcap-ng.so.0
RUN ldconfig \
    && setpriv --version
WORKDIR /opt/maintainflow
COPY --from=builder /out/policy-dialer ./bin/policy-dialer
COPY infra/browser-egress-proxy/policy ./policy
COPY infra/browser-egress-proxy/deploy/runtime_guard.py ./deploy/runtime_guard.py
COPY infra/browser-egress-proxy/deploy/firewall/dialer-bootstrap.nft ./deploy/dialer-bootstrap.nft
COPY infra/browser-egress-proxy/deploy/scripts/dialer-entrypoint.sh ./deploy/dialer-entrypoint.sh
RUN chmod 0555 ./bin/policy-dialer ./deploy/runtime_guard.py ./deploy/dialer-entrypoint.sh \
    && chmod 0444 ./deploy/dialer-bootstrap.nft ./policy/*
USER 0:0
ENTRYPOINT ["/opt/maintainflow/deploy/dialer-entrypoint.sh"]
