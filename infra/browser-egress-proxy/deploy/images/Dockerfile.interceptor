# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.13.11-slim-trixie@sha256:2b9c9803c6a287cafa0a8c917211dddd23dcd2016f049690ee5219f5d3f1636e

FROM ${PYTHON_IMAGE} AS wheel-builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/interceptor
COPY infra/browser-egress-proxy/interceptor/ ./
RUN python -m pip install --require-hashes -r build-requirements.lock
RUN mkdir -p /wheelhouse /patched \
    && python -m pip wheel \
      --only-binary=:all: \
      --no-deps \
      --require-hashes \
      --wheel-dir /wheelhouse \
      -r requirements.lock \
    && python build_patched_wheels.py --output /patched

FROM ${PYTHON_IMAGE} AS privilege-tool-source
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends util-linux \
    && mkdir -p /out/bin /out/lib \
    && cp /usr/bin/setpriv /out/bin/setpriv \
    && setpriv_library="$(ldd /usr/bin/setpriv | awk '$1 == "libcap-ng.so.0" { print $3 }')" \
    && test -n "${setpriv_library}" \
    && cp -L "${setpriv_library}" /out/lib/libcap-ng.so.0 \
    && /out/bin/setpriv --version \
    && rm -rf /var/lib/apt/lists/*

FROM ${PYTHON_IMAGE} AS runtime
ENV HOME=/nonexistent \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates nftables \
    && apt-get purge --allow-remove-essential --yes \
      bsdutils \
      gzip \
      libblkid1 \
      liblastlog2-2 \
      libmount1 \
      libncursesw6 \
      libsmartcols1 \
      libsqlite3-0 \
      libuuid1 \
      login \
      mount \
      ncurses-base \
      ncurses-bin \
      perl-base \
      util-linux \
    && rm -f /usr/local/lib/python3.13/lib-dynload/_sqlite3*.so \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 maintainflow \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin maintainflow
COPY --from=privilege-tool-source /out/bin/setpriv /usr/local/bin/setpriv
COPY --from=privilege-tool-source /out/lib/libcap-ng.so.0 /usr/local/lib/libcap-ng.so.0
RUN ldconfig \
    && setpriv --version
WORKDIR /opt/maintainflow/interceptor
COPY infra/browser-egress-proxy/interceptor/requirements.lock ./requirements.lock
RUN --mount=from=wheel-builder,source=/wheelhouse,target=/wheelhouse,ro \
    --mount=from=wheel-builder,source=/patched,target=/patched,ro \
    python -m pip install \
      --no-index \
      --no-deps \
      --find-links=/wheelhouse \
      --require-hashes \
      -r requirements.lock \
    && python -m pip install \
      --no-index \
      --no-deps \
      --force-reinstall \
      /patched/h11-0.16.0-*.whl \
      /patched/mitmproxy-12.2.3-*.whl
COPY infra/browser-egress-proxy/interceptor/addons ./addons
COPY infra/browser-egress-proxy/interceptor/load_policy.py ./load_policy.py
COPY infra/browser-egress-proxy/interceptor/post_image_verify.py ./post_image_verify.py
COPY infra/browser-egress-proxy/interceptor/pinned-source.json ./pinned-source.json
COPY infra/browser-egress-proxy/interceptor/egress-init.sh ./egress-init.sh
COPY --from=wheel-builder /patched/patched-runtime-manifest.json ./patched-runtime-manifest.json
COPY infra/browser-egress-proxy/deploy/runtime_guard.py /opt/maintainflow/deploy/runtime_guard.py
COPY infra/browser-egress-proxy/deploy/firewall/interceptor-bootstrap.nft /opt/maintainflow/deploy/interceptor-bootstrap.nft
COPY infra/browser-egress-proxy/deploy/scripts/interceptor-entrypoint.sh /opt/maintainflow/deploy/interceptor-entrypoint.sh
RUN python post_image_verify.py --manifest pinned-source.json \
    && chmod 0555 /opt/maintainflow/deploy/interceptor-entrypoint.sh /opt/maintainflow/deploy/runtime_guard.py /opt/maintainflow/interceptor/egress-init.sh \
    && chmod 0444 /opt/maintainflow/deploy/interceptor-bootstrap.nft
EXPOSE 8080
USER 0:0
ENTRYPOINT ["/opt/maintainflow/deploy/interceptor-entrypoint.sh"]
